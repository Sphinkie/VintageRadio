    <!-- ==================== 74HC595 #1 ==================== -->
    <mxCell id="ic1" value="&lt;b&gt;74HC595 #1&lt;/b&gt; — LEDs v1 à v7&lt;hr/&gt;&lt;table width='180' style='font-size:9px'&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ DS (14)&lt;/td&gt;&lt;td align='right'&gt;Q0 (15) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ SHCP (11)&lt;/td&gt;&lt;td align='right'&gt;Q1 (1) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ STCP (12)&lt;/td&gt;&lt;td align='right'&gt;Q2 (2) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ OE (13) → GND&lt;/td&gt;&lt;td align='right'&gt;Q3 (3) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ MR (10) → 5V&lt;/td&gt;&lt;td align='right'&gt;Q4 (4) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ VCC (16) → 5V&lt;/td&gt;&lt;td align='right'&gt;Q5 (5) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ GND (8) → GND&lt;/td&gt;&lt;td align='right'&gt;Q6 (6) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;&amp;nbsp;&lt;/td&gt;&lt;td align='right'&gt;Q7 (7) nc&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;&amp;nbsp;&lt;/td&gt;&lt;td align='right'&gt;&lt;font color='#00AA00'&gt;&lt;b&gt;Q7' (9) ►&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=center;" vertex="1" parent="1">
      <mxGeometry x="250" y="70" width="200" height="310" as="geometry" />
    </mxCell>

