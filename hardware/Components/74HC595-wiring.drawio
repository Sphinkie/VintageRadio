    <mxCell id="warn" value="&lt;b&gt;⚠ Niveau logique&lt;/b&gt;&lt;br&gt;RPi GPIO = 3,3V&lt;br&gt;74HC595 VCC = 5V&lt;br&gt;→ Ajouter &lt;b&gt;74AHCT125&lt;/b&gt;&lt;br&gt;sur MOSI, SCLK, LATCH" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;verticalAlign=middle;align=left;" vertex="1" parent="1">
