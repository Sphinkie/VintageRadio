    <!-- ==================== 74HC595 #2 ==================== -->
    <mxCell id="ic2" value="&lt;b&gt;74HC595 #2&lt;/b&gt; — LEDs L1, L2, L3, L4&lt;hr/&gt;&lt;table width='180' style='font-size:9px'&gt;&lt;tr&gt;&lt;td align='left'&gt;&lt;font color='#00AA00'&gt;&lt;b&gt;◄ DS (14)&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td align='right'&gt;Q0 → L1 (blanc 380Ω) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ SHCP (11)&lt;/td&gt;&lt;td align='right'&gt;Q1 → L2 (blanc 380Ω) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ STCP (12)&lt;/td&gt;&lt;td align='right'&gt;Q2 → L3 (jaune 150Ω) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ OE (13) → GND&lt;/td&gt;&lt;td align='right'&gt;Q3 → L4 (jaune 150Ω) ►&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ MR (10) → 5V&lt;/td&gt;&lt;td align='right'&gt;Q4..Q7 nc&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ VCC (16) → 5V&lt;/td&gt;&lt;td align='right'&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;◄ GND (8) → GND&lt;/td&gt;&lt;td align='right'&gt;&amp;nbsp;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left'&gt;&amp;nbsp;&lt;/td&gt;&lt;td align='right'&gt;Q7'(9) nc&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=top;align=center;" vertex="1" parent="1">
